# ============================================================
# BOMHort – Local Configuration
# ============================================================
# Copy this file to .env and adjust to your setup:
#   cp .env.example .env

# ── S3 Bucket Ingestion (default, recommended) ────────────────
# Ingest SBOMs directly from S3-compatible buckets (AWS S3, MinIO, GCS).
# This is the default ingestion method. No volumes or git-sync needed.
# Multiple buckets are supported via JSON array.

# Option A: Multiple buckets via JSON (recommended)
# S3_BUCKETS='[{"name":"my-org-sboms","endpoint":"s3.amazonaws.com","region":"us-east-1"},{"name":"platform-sboms","region":"us-east-1"}]'

# Each bucket may additionally carry "cluster", "namespace", "project",
# "pathLayout" and "tags" (see "Ownership & Grouping" below). Note that
# "pathLayout" and "tags" do different jobs: pathLayout picks the real project
# out of the object key, while tags label what kind of project it is.
# S3_BUCKETS='[{"name":"sboms-sandbox","region":"us-east-1","pathLayout":"project","tags":["sandbox-applications"]}]'

# Option B: Single bucket via individual env vars
# S3_BUCKET=my-sbom-bucket
# S3_ENDPOINT=s3.amazonaws.com
# S3_REGION=us-east-1
# S3_PREFIX=

# Shared S3 credentials (applied to all buckets without their own keys).
# For public buckets, leave empty.
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# MinIO-specific options:
# S3_USE_PATH_STYLE=true
# S3_USE_SSL=false

# ── Local SBOM Source (alternative to S3) ─────────────────────
# Path to your SBOM files on the local filesystem.
# Used alongside or instead of S3. Can point to an external repo checkout.
# Default: ./sboms (bundled examples)
SBOM_SOURCE_DIR=./sboms

# ── Ownership & Grouping ──────────────────────────────────────
# How ingested SBOMs are attributed. All default to "" (unassigned), which is
# a valid steady state — set only what your instance actually has.
#
# There are two ways to run BOMHort, and they use different dimensions:
#
#   A) Deployment fleet (companies running workloads on Kubernetes)
#      cluster → namespace → project describes WHERE a workload runs.
#
#   B) Catalogue / portfolio (foundations, vendors, product lines)
#      Nothing runs in a cluster, so cluster/namespace stay empty forever.
#      Use project + TAGS instead.

# Pin every ingested document to one cluster/namespace/project.
# CLUSTER_NAME=prod-eu
# NAMESPACE=payments
# PROJECT=checkout-service

# Derive the above from each SBOM's position in the source tree instead of
# pinning it. Tokens: cluster, namespace, project, and _ to skip a segment.
# Example: "cluster/namespace/project" reads prod-eu/payments/checkout/app.spdx.json
# Example: "_/project" reads sandbox/k2s/sbom.spdx.json as project=k2s
# INGEST_PATH_LAYOUT=cluster/namespace/project

# TAGS are free-form grouping labels, orthogonal to the triple above. They say
# WHAT KIND of thing a project is, not where it runs — which is what makes them
# work in mode B, where there is no cluster at all.
#
# Tags group projects, they do NOT replace them: with TAGS=sandbox-applications
# a project "k2s" carrying three SBOMs stays the project "k2s" and additionally
# becomes reachable via the sandbox-applications grouping.
#
# Comma-separated; normalised to lowercase. Additive rather than overriding:
# per-bucket tags (see "tags" in S3_BUCKETS) and per-upload ?tags= are merged
# with these, because "this bucket holds sandbox apps" does not contradict an
# instance-wide "all of this is the platform group".
#
# Read back via GET /api/v1/tags; filter with GET /api/v1/projects?tag=<tag>.
# An instance that sets nothing here gets an empty tag list and the UI hides
# the grouping affordance entirely.
# TAGS=sandbox-applications,platform

# ── Ingestion tuning ──────────────────────────────────────────
# Max SBOMs to enqueue per watcher run (0 = all).
# Use 50–200 for quick local dev, 0 for full ingestion.
SBOM_LIMIT=200

# Skip local files whose names start with this prefix (e.g. "_" for demo files).
# Set to empty string to include all files. Only applies to local filesystem scan.
# SBOM_IGNORE_PREFIX=_

# ── Worker tuning ─────────────────────────────────────────────
# Number of parallel parsing worker containers.
WORKER_REPLICAS=2

# Jobs claimed per polling cycle per worker.
WORKER_BATCH_SIZE=50

# Skip OSV vulnerability API calls for fast ingestion (licenses only).
# Set to "true" for initial bulk load, then re-run with "false".
SKIP_OSV=true

# ── GitHub License Resolution ─────────────────────────────────
# Resolves unknown/NOASSERTION licenses by querying GitHub API.
# Without token: 60 requests/hour. With token: 5000 requests/hour.
# Create at: https://github.com/settings/tokens (no scopes needed for public repos)
SKIP_GITHUB_RESOLVE=false
GITHUB_TOKEN=

# ── Package Registry License Resolution ───────────────────────
# Resolves unknown/NOASSERTION licenses via public registries (no auth needed):
#   npm   → registry.npmjs.org
#   NuGet → api.nuget.org (legacy packages fall back to their GitHub repo license)
SKIP_NPM_RESOLVE=false
SKIP_NUGET_RESOLVE=false

# ── Push-Model Uploads (POST /api/v1/sboms/upload) ────────────
# Max accepted request body size for the upload endpoint, in MB.
# The endpoint refuses every request unless AUTH_ENABLED=true.
# MAX_UPLOAD_SIZE_MB=50

# ── UI Customization ──────────────────────────────────────────
# Path to a custom CSS theme file for the UI (overrides CSS variables without rebuild).
# See ui/src/assets/custom-theme.example.css for all available variables.
# CUSTOM_THEME=./my-theme.css

# Path to a JSON file with UI text overrides (brand name, dashboard texts, disclaimer).
# All fields are optional – missing keys fall back to built-in BOMHort defaults.
# UI_CONFIG=./my-ui-config.json
